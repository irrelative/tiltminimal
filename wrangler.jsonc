{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiltminimal",
  "main": "src/server/worker.ts",
  "account_id": "fcb71c65b78f89d7622891634112e7f3",
  "compatibility_date": "2026-05-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/stats"],
  },
  "routes": [
    { "pattern": "tiltminimal.com", "custom_domain": true },
    { "pattern": "www.tiltminimal.com", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinball-stats",
      "database_id": "c41449ef-06a7-429a-a0ed-739f46694e25",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "EVENT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
